<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>

<BorderPane
	fx:controller="subscriberDetailsControllerManager"
	xmlns:fx="http://javafx.com/fxml"
	xmlns="http://javafx.com/javafx/8.0.171" prefHeight="600"
	prefWidth="850" stylesheets="@updateorder.css">
	<!-- Top Bar -->
	<top>
		<HBox spacing="20" alignment="CENTER_LEFT" styleClass="top-bar">
			<children>
				<Button fx:id="LogoutButton" onAction="#handleLogout"
					styleClass="logout-button" text="Logout" />
				<Label text="Subscriber Details" styleClass="main-title" />
			</children>
		</HBox>
	</top>
	<left>
		<VBox alignment="TOP_CENTER" prefWidth="180" spacing="20"
			styleClass="side-panel">
			<children>

				<Button styleClass="side-menu-button-selected"
					text="Subscriber details" onAction="#subscriberDetailsBtn" />
				<Button onAction="#parkingActiveDetailsBtn"
					styleClass="side-menu-button" text="Parking active details" />

				<Button maxWidth="160.0" minHeight="40.0"
					mnemonicParsing="false" onAction="#reportsBtn"
					styleClass="side-menu-button" text="Parking Reports"
					wrapText="true" />
				<Button maxWidth="160.0" minHeight="40.0"
					mnemonicParsing="false" onAction="#MonthlyreportsBtn"
					styleClass="side-menu-button" text="Monthly Parking Reports"
					wrapText="true" />
			</children>
			<padding>
				<Insets top="40" />
			</padding>
		</VBox>
	</left>

	<center>
		<VBox alignment="TOP_CENTER" spacing="20"
			style="-fx-padding: 30;" prefHeight="400" prefWidth="600">
			<TableView fx:id="subscriberTable" prefHeight="400"
				prefWidth="600">

				<columns>
					<TableColumn text="Code" prefWidth="100"
						fx:id="codeCol" />
					<TableColumn text="Username" prefWidth="100"
						fx:id="usernameCol" />
					<TableColumn text="Password" prefWidth="100"
						fx:id="passwordCol" />
					<TableColumn text="Phone number" prefWidth="100"
						fx:id="phoneNumberCol" />
					<TableColumn text="Email" prefWidth="100"
						fx:id="emailCol" />
				</columns>
			</TableView>
		</VBox>
	</center>

</BorderPane>
